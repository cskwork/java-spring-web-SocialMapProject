# Values are placeholders. Use a NEW isolated Oracle development schema.
SOCIALMAP_DB_URL=jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1
SOCIALMAP_DB_USER=socialmap_synthetic
SOCIALMAP_DB_PASSWORD=replace-locally
SERVLET_API_JAR=/absolute/path/to/servlet-api-2.5.jar
# No email transport: password reset writes only the DB-local local_outbox table.

# Dedicated writable local directory outside webroot; required for actual PNG/JPEG upload.
SOCIALMAP_UPLOAD_DIR=/absolute/private/socialmap-images
