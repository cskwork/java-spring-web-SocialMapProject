<%@ page contentType="text/html; charset=EUC-KR" pageEncoding="EUC-KR" %>
<%@ taglib prefix="s" uri="/struts-tags" %>
<html lang="ko"><head><title>게시물 관리 · SocialMap</title><meta name="csrf-token" content="<s:property value="#session.csrf"/>"><script src="js/native-forms.js" defer></script></head><body><section class="sm-workspace"><header class="sm-page-heading"><h2>게시물 관리</h2></header><h3><s:property value="heading"/></h3><form method="post" enctype="multipart/form-data" accept-charset="UTF-8" action="<s:property value="action"/>.action"><input type="hidden" name="csrf" value="<s:property value="#session.csrf"/>"><input type="hidden" name="step" value="1"><input type="hidden" name="no" value="<s:property value="no"/>"><label>제목<input type="text" name="title" value="<s:property value="resultClass.title"/>" required></label><label>내용<textarea name="cont" required><s:property value="resultClass.cont"/></textarea></label><label>시작일<input type="date" name="startdate" value="<s:property value="resultClass.startdate"/>"></label><label>종료일<input type="date" name="enddate" value="<s:property value="resultClass.enddate"/>"></label><s:if test="action == 'CompWrite' || action == 'CompModify'"><label>공모전 이미지 (PNG/JPEG, 최대 2 MiB)<input type="file" name="upload" accept="image/png,image/jpeg"></label></s:if><label>합성 첨부<select name="fixture"><option value="">첨부 없음</option><option value="fixture-poster.svg">가상 공모전 포스터</option><option value="fixture-guide.txt">가상 안내문</option></select></label><s:if test="action == 'QnaAdminWrite' || action == 'QnaAdminModify'"><label><input type="checkbox" name="remove" value="1">기존 답변 삭제</label></s:if><button type="submit">저장</button></form></section></body></html>