<%@ page contentType="text/html; charset=EUC-KR" pageEncoding="EUC-KR" %>
<%@ taglib prefix="s" uri="/struts-tags" %>
<html lang="ko"><head><title>회원가입 · SocialMap</title></head><body><section class="sm-workspace"><header class="sm-page-heading"><h2>회원가입</h2></header><form method="post" action="SignUp.action"><input type="hidden" name="step" value="1"><label>아이디<input type="text" name="id" value="<s:property value="resultClass.id"/>" required></label><label>비밀번호 (8자 이상)<input type="password" name="pwd" value="<s:property value="resultClass.pwd"/>" required></label><label>이름<input type="text" name="name" value="<s:property value="resultClass.name"/>" required></label><label>이메일<input type="email" name="email" value="<s:property value="resultClass.email"/>" required></label><label>역할<select name="auth"><option value="2">팀원</option><option value="1">팀장</option></select></label><button type="submit">저장</button></form><a href="Login.action">로그인</a></section></body></html>